#!/bin/sh
# Blocks commits that contain a .env file or a HubSpot access token.

fail=0

for f in $(git diff --cached --name-only --diff-filter=ACM); do
  case "$(basename "$f")" in
    .env.example) ;;
    .env|.env.*) echo "Blocked: $f is a secrets file. Remove it with: git rm --cached $f"; fail=1 ;;
  esac
done

if git diff --cached -U0 | grep -E '^\+' | grep -qE 'pat-(na|eu|ap)[0-9]+-[0-9a-fA-F]{8}-'; then
  echo "Blocked: a HubSpot token (pat-...) is in the staged changes. Move it to requests/.env."
  fail=1
fi

exit $fail
